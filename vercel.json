{
  "buildCommand": "bash build.sh",
  "outputDirectory": "web/dist",
  "framework": "vite",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/aihub/:path*",
      "destination": "/aihub/index.html"
    },
    {
      "source": "/learn/:path*",
      "destination": "/learn/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}

